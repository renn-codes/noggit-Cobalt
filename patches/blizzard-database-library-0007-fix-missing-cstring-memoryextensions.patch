From 37a0200a91a78b3857a8aca0629a86aea1f67acb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 11 Sep 2026 13:09:14 +0000
Subject: [PATCH 5/6] Fix missing <cstring> include in MemoryExtensions.h

Relies on the memcpy/memset family without including <cstring>,
which isn't guaranteed to be pulled in transitively by anything else
this file includes.
---
 include/extensions/MemoryExtensions.h | 1 +
 1 file changed, 1 insertion(+)

diff --git a/include/extensions/MemoryExtensions.h b/include/extensions/MemoryExtensions.h
index e9e80bc..5f16cd0 100644
--- a/include/extensions/MemoryExtensions.h
+++ b/include/extensions/MemoryExtensions.h
@@ -1,4 +1,5 @@
 #pragma once
+#include <cstring>
 #include <string>
 #include <sstream>
 
