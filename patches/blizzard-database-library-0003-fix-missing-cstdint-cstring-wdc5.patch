From 4e773c0bddadb929471b7c9fda2b0c56fea294da Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 11 Sep 2026 13:09:01 +0000
Subject: [PATCH 1/6] Fix missing <cstdint>/<cstring> includes in
 WDC5TableReader.cpp

uint32_t is used directly (e.g. _streamReader->Read<uint32_t>()) and
the file also relies on the memcpy/memset family, neither of which is
guaranteed available without <cstdint>/<cstring> respectively. Fails
under GCC/libstdc++ with "'uint32_t' was not declared in this scope",
which then cascades into "'encryptedIDCount' was not declared in this
scope" on the next line since the local variable that would have held
it never gets declared.
---
 src/readers/wdc5/WDC5TableReader.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/readers/wdc5/WDC5TableReader.cpp b/src/readers/wdc5/WDC5TableReader.cpp
index c192688..9f8fd59 100644
--- a/src/readers/wdc5/WDC5TableReader.cpp
+++ b/src/readers/wdc5/WDC5TableReader.cpp
@@ -1,4 +1,7 @@
 #include <readers/wdc5/WDC5TableReader.h>
+
+#include <cstdint>
+#include <cstring>
 namespace BlizzardDatabaseLib {
     namespace Reader {
 
